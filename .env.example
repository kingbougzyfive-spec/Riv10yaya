# --- REQUIRED ---
# Long random string (32+ chars). Signs sessions and encrypts stored database URIs.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public URL of the site (used for QR codes / PWA later)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- DATABASE (optional here: you can also add URIs from /setup or Admin > Database) ---
MONGODB_URI=
# Optional extra bootstrap URIs, tried in order if the active one fails
MONGODB_URI_BACKUP_1=
MONGODB_URI_BACKUP_2=
MONGODB_URI_BACKUP_3=

# --- EMAIL (optional) ---
# Registration confirmations are emailed only when this is set. Without it, nothing is sent (and the app doesn't pretend otherwise).
RESEND_API_KEY=
MAIL_FROM=YAYA <onboarding@resend.dev>

# --- GOOGLE SHEETS (optional) ---
# Service-account JSON (raw JSON or base64 of it) and the target spreadsheet id. Share the sheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
# The spreadsheet can also be set on Admin → Integrations → Google Sheets. Daily auto-sync uses CRON_SECRET.

# --- AI RECEIPT READING (optional) ---
TERMII_API_KEY=
TERMII_SENDER_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
CRON_SECRET=

# --- First administrator (pick ONE way) ---
# A) Open /setup on the new site and create the first Super Administrator yourself. To stop a stranger doing it
#    first on a public URL, set SETUP_TOKEN to a long random value and enter it on the setup page.
SETUP_TOKEN=
# B) Temporary administrator from the server environment. Created once, only when the database has no users.
#    The password is hashed, never shown in the browser, and MUST be replaced at first sign-in.
#    After that, DELETE both settings and redeploy. Admin > Security warns while they remain.
#    Never use a NEXT_PUBLIC_ prefix for these: that would publish them to every visitor.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
